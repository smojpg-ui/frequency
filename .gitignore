# loose art stays out of git until the artist says yes.
#   art/          = her drop box for drafts and works in progress (never committed)
#   assets/art/   = approved pieces only; a piece moves here on her yes, and is committed
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.heic
*.tif
*.tiff
*.psd
*.procreate
*.clip
*.kra
*.mp4
*.mov
/art/
!assets/art/
!assets/art/**

# her untouched originals stay on this Mac. the public repo carries editions/ (her approved copies).
# SHA256SUMS still verifies them locally: shasum -a 256 -c SHA256SUMS
/originals/

# machine + editor noise
.DS_Store
*.swp
.vscode/

# claude's local settings stay local; the preview config is shared on purpose
.claude/*
!.claude/launch.json
